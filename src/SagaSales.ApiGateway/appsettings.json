{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5008", "https://localhost:5008" ]
  },
  "Jwt": {
    "Key": "SagaSales-dev-signing-key-please-replace-in-production-2026",
    "Issuer": "SagaSales.Identity",
    "Audience": "SagaSales.Api",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "catalog-products": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "catalog-suppliers": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/suppliers/{**catch-all}" }
      },
      "catalog-purchases": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/purchases/{**catch-all}" }
      },
      "catalog-branches": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/branches/{**catch-all}" }
      },
      "catalog-settings": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/settings/{**catch-all}" }
      },
      "catalog-inventory": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "catalog-images": {
        "ClusterId": "catalog",
        "Match": { "Path": "/images/{**catch-all}" }
      },
      "sales": {
        "ClusterId": "sales",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "payment-webhooks": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/webhooks/{**catch-all}" }
      },
      "customer": {
        "ClusterId": "customer",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      },
      "notification": {
        "ClusterId": "notification",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "taxes": {
        "ClusterId": "sales",
        "Match": { "Path": "/api/taxes/{**catch-all}" }
      }
    },

    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://localhost:5001/" } }
      },
      "catalog": {
        "Destinations": { "primary": { "Address": "http://localhost:5002/" } }
      },
      "sales": {
        "Destinations": { "primary": { "Address": "http://localhost:5003/" } }
      },
      "payment": {
        "Destinations": { "primary": { "Address": "http://localhost:5004/" } }
      },
      "customer": {
        "Destinations": { "primary": { "Address": "http://localhost:5005/" } }
      },
      "analytics": {
        "Destinations": { "primary": { "Address": "http://localhost:5006/" } }
      },
      "notification": {
        "Destinations": { "primary": { "Address": "http://localhost:5007/" } }
      }
    }
  }
}
