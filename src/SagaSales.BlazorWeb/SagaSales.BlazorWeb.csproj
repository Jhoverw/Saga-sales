<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SagaSales.BlazorWeb</RootNamespace>
    <AssemblyName>SagaSales.BlazorWeb</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SagaSales.Shared\SagaSales.Shared.csproj" />
  </ItemGroup>

  <!--
    No PackageReference to Microsoft.AspNetCore.Components.*: the BlazorWebAssembly SDK already
    supplies the runtime, the components and the matching blazor.webassembly.js.

    Pinning those packages to an older band was the cause of
    "TypeError: Cannot read properties of undefined (reading 'getI32')": a v8 script was being
    loaded against the .NET 10 runtime, so the renderer's memory view did not exist.
  -->

  <ItemGroup>
    <Content Update="wwwroot\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
