<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SagaSales.BlazorWeb</RootNamespace>
    <AssemblyName>SagaSales.BlazorWeb</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SagaSales.Shared\SagaSales.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      These must stay in the same band as TargetFramework (10.x).

      Pinned to 8.0.4 they made the app load a v8 blazor.webassembly.js against the .NET 10
      runtime, which failed at render with:
        TypeError: Cannot read properties of undefined (reading 'getI32')
      The package carries the runtime script, so its version has to match the framework.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
