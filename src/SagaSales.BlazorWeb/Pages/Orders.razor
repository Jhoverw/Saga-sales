@page "/orders"
@attribute [Authorize]
@inject ApiClient Api

<div class="page-head">
    <div>
        <h1>Pedidos</h1>
        <div class="page-head__sub">Registrar la venta, cobrarla y cancelarla devolviendo el stock</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert @(Error ? "alert-danger" : "alert-info")">@Message</div>
}

<div class="panel">
    <div class="panel__head">Nuevo pedido</div>
    <div class="panel__body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Cliente</label>
                <select class="form-select" @bind="CustomerId">
                    <option value="@Guid.Empty">— elige —</option>
                    @foreach (var customer in Customers)
                    {
                        <option value="@customer.Id">@(customer.BusinessName ?? $"{customer.LastName}, {customer.FirstName}")</option>
                    }
                </select>
            </div>
            <div class="col-md-8">
                <label class="form-label">Dirección de envío</label>
                <input class="form-control" @bind="ShippingAddress" @bind:event="oninput" placeholder="Calle, ciudad" />
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label">Productos</label>
            @foreach (var line in Lines)
            {
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-6">
                        <select class="form-select" @bind="line.ProductId">
                            <option value="@Guid.Empty">— elige producto —</option>
                            @foreach (var product in Products)
                            {
                                <option value="@product.Id">@product.Name · @product.BasePrice.ToString("C") · stock @product.StockQuantity</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input class="form-control" type="number" lang="en-US" min="1" @bind="line.Quantity" placeholder="Cant." />
                    </div>
                    <div class="col-md-3 text-end">
                        <span class="page-head__sub">@LinePreviewText(line)</span>
                    </div>
                    <div class="col-md-1 text-end">
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(line)" disabled="@(Lines.Count == 1)">×</button>
                    </div>
                </div>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="AddLine">+ Agregar producto</button>
        </div>

        <div class="d-flex align-items-center gap-3 mt-3">
            <button class="btn btn-primary" @onclick="CreateAsync" disabled="@Busy">
                @(Busy ? "Guardando..." : "Crear pedido")
            </button>
            <span class="page-head__sub mb-0">El IVA vigente y el total se calculan al guardar.</span>
        </div>
    </div>
</div>

<div class="panel mt-3">
    <div class="panel__head">
        <span>Pedidos</span>
        <select class="form-select form-select-sm ms-auto" style="max-width:220px;" @bind="FilterValue" @bind:event="onchange" @bind:after="LoadOrdersAsync">
            <option value="">Todos los estados</option>
            <option value="Pending">Pendiente</option>
            <option value="Confirmed">Confirmado</option>
            <option value="Processing">En proceso</option>
            <option value="Shipped">Enviado</option>
            <option value="Delivered">Entregado</option>
            <option value="Cancelled">Cancelado</option>
            <option value="Refunded">Reembolsado</option>
        </select>
    </div>
    <div class="panel__body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th class="text-end">IVA</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Pagado</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in OrderList)
                {
                    <tr class="@(Selected?.Id == order.Id ? "table-active" : "")">
                        <td>@order.OrderDate.ToString("dd/MM HH:mm")</td>
                        <td><code>@(string.IsNullOrEmpty(order.OrderNumber) ? "—" : order.OrderNumber)</code></td>
                        <td>@CustomerName(order.CustomerId)</td>
                        <td class="text-end">@order.TaxAmount.ToString("C")</td>
                        <td class="text-end">@order.Total.ToString("C")</td>
                        <td class="text-end">@order.PaidAmount.ToString("C")</td>
                        <td><span class="chip">@StatusLabel(order.Status)</span></td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Select(order)">Abrir</button>
                        </td>
                    </tr>
                }
                @if (OrderList.Count == 0)
                {
                    <tr><td colspan="8" class="text-center py-3">Todavía no hay pedidos.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Selected is not null)
{
    <div class="row g-3 mt-1">
        <div class="col-lg-6">
            <div class="panel">
                <div class="panel__head d-flex align-items-center gap-2">
                    <span>Pedido @Selected.OrderNumber · @StatusLabel(Selected.Status)</span>
                    <a class="btn btn-sm btn-outline-secondary ms-auto" href="/receipt/@Selected.Id" target="_blank">Ver recibo</a>
                </div>
                <div class="panel__body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr><th>Producto</th><th class="text-end">Cant.</th><th class="text-end">Precio c/IVA</th><th class="text-end">Total c/IVA</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Selected.Items)
                            {
                                <tr>
                                    <td>@line.ProductName</td>
                                    <td class="text-end">@line.Quantity</td>
                                    <td class="text-end">@line.UnitPriceWithTax.ToString("C")</td>
                                    <td class="text-end">@line.LineTotal.ToString("C")</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="3" class="text-end">Subtotal</td>
                                <td class="text-end">@Selected.Subtotal.ToString("C")</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end">IVA</td>
                                <td class="text-end">@Selected.TaxAmount.ToString("C")</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end"><strong>Total</strong></td>
                                <td class="text-end"><strong>@Selected.Total.ToString("C")</strong></td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end">Pagado</td>
                                <td class="text-end">@Selected.PaidAmount.ToString("C")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="panel">
                <div class="panel__head">Avanzar estado</div>
                <div class="panel__body">
                    <div class="d-flex align-items-center gap-2">
                        <span class="chip chip--info">@StatusLabel(Selected.Status)</span>
                        @if (NextTransition(Selected.Status) is { } next)
                        {
                            <AuthorizeView Roles="@SagaSalesRoles.ManagerOrOwner" Context="auth">
                                <button class="btn btn-sm btn-primary" @onclick="AdvanceAsync" disabled="@Busy">
                                    @NextTransitionLabel(Selected.Status)
                                </button>
                            </AuthorizeView>
                        }
                        else
                        {
                            <span class="page-head__sub mb-0">Estado final (o se cancela/desde cobro).</span>
                        }
                    </div>
                </div>
            </div>

            <div class="panel mt-3">
                <div class="panel__head">Cobro</div>
                <div class="panel__body">
                    @if (Pending > 0)
                    {
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label">Importe</label>
                                <DecimalInput @bind-Value="Amount" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Medio</label>
                                <select class="form-select" @bind="MethodId">
                                    <option value="5">Efectivo</option>
                                    <option value="1">Tarjeta</option>
                                    <option value="4">Transferencia</option>
                                    <option value="9">Depósito</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-primary w-100" @onclick="ChargeAsync" disabled="@Busy">Registrar cobro</button>
                            </div>
                        </div>
                        @if (MethodId == 5)
                        {
                            <div class="row g-2 align-items-end mt-2">
                                <div class="col-md-4">
                                    <label class="form-label">Monto recibido</label>
                                    <DecimalInput @bind-Value="CashReceived" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Vuelto</label>
                                    <input class="form-control" readonly value="@ChangeDue.ToString("C")" />
                                </div>
                                @if (CashShort)
                                {
                                    <div class="col-md-4 text-danger small">El monto recibido es menor que el importe a cobrar.</div>
                                }
                            </div>
                        }
                        else if (MethodId is 1 or 4 or 9)
                        {
                            <div class="mt-2">
                                <label class="form-label">@(MethodId == 1 ? "Últimos 4 dígitos (opcional)" : "Referencia (opcional)")</label>
                                <input class="form-control" @bind="Reference" />
                            </div>
                        }
                        <div class="page-head__sub mt-2 mb-0">Pendiente de cobro: @Pending.ToString("C")</div>
                    }
                    else
                    {
                        <p class="mb-0">Este pedido está cobrado por completo.</p>
                    }

                    @if (Selected.Status is "Pending" or "Confirmed" or "Processing")
                    {
                        <AuthorizeView Roles="@SagaSalesRoles.ManagerOrOwner" Context="auth">
                            <hr class="divider" />
                            <button class="btn btn-outline-danger" @onclick="CancelAsync" disabled="@Busy">
                                Cancelar pedido y devolver stock
                            </button>
                        </AuthorizeView>
                    }
                </div>
            </div>

            <div class="panel mt-3">
                <div class="panel__head">Pagos registrados</div>
                <div class="panel__body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr><th>Fecha</th><th class="text-end">Importe</th><th class="text-end">Devuelto</th><th>Estado</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in PaymentList)
                            {
                                <tr>
                                    <td>@payment.CreatedAt.ToString("dd/MM HH:mm")</td>
                                    <td class="text-end">@payment.Amount.ToString("C")</td>
                                    <td class="text-end">@payment.RefundedAmount.ToString("C")</td>
                                    <td><span class="chip">@PaymentStatusLabel(payment.Status)</span></td>
                                    <td class="text-end">
                                        @if (payment.RefundableAmount > 0)
                                        {
                                            <AuthorizeView Roles="@SagaSalesRoles.ManagerOrOwner" Context="auth"><button class="btn btn-sm btn-outline-secondary" @onclick="() => RefundAsync(payment)">Reembolsar</button></AuthorizeView>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (PaymentList.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center py-3">Sin pagos.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<OrderDto> OrderList { get; set; } = [];
    private List<CustomerDto> Customers { get; set; } = [];
    private List<ProductDto> Products { get; set; } = [];

    private OrderDto? Selected { get; set; }
    private List<PaymentDto> PaymentList { get; set; } = [];

    private Guid CustomerId { get; set; } = Guid.Empty;
    private List<LineDraft> Lines { get; set; } = [new()];
    private string ShippingAddress { get; set; } = string.Empty;

    /// <summary>One product line of the order being typed. Quantity and product are edited in place.</summary>
    private sealed class LineDraft
    {
        public Guid ProductId { get; set; } = Guid.Empty;

        public int Quantity { get; set; } = 1;
    }

    private void AddLine() => Lines.Add(new LineDraft());

    private void RemoveLine(LineDraft line)
    {
        if (Lines.Count > 1) { Lines.Remove(line); }
    }

    // Preview only; the stored amounts come from the server. A PVP already includes VAT (spec 003);
    // a product not yet converted shows its base and the server adds the VAT.
    private string LinePreviewText(LineDraft line)
    {
        var product = Products.FirstOrDefault(p => p.Id == line.ProductId);
        if (product is null)
        {
            return 0m.ToString("C");
        }

        var amount = product.BasePrice * Math.Max(1, line.Quantity);
        return product.PriceIncludesTax || !product.IsTaxable
            ? $"{amount:C} con IVA"
            : $"{amount:C} sin IVA";
    }

    private decimal Amount { get; set; }
    private int MethodId { get; set; } = 5;

    // Cash (H-09): amount handed over and change due. Card/transfer reference (H-10) is optional.
    private decimal? CashReceived { get; set; }
    private string Reference { get; set; } = string.Empty;

    private decimal ChangeDue => MethodId == 5 && CashReceived is { } received ? Math.Max(0, received - Amount) : 0m;

    private bool CashShort => MethodId == 5 && CashReceived is { } received && received < Amount;

    private string FilterValue { get; set; } = string.Empty;

    private OrderStatus? FilterStatus
        => string.IsNullOrWhiteSpace(FilterValue) || !Enum.TryParse<OrderStatus>(FilterValue, out var status)
            ? null
            : status;

    private string? Message { get; set; }
    private bool Error { get; set; }
    private bool Busy { get; set; }

    // What the customer still owes includes VAT: the total, not the subtotal.
    private decimal Pending => Selected is null ? 0 : Math.Max(0, Selected.Total - Selected.PaidAmount);

    protected override async Task OnInitializedAsync()
    {
        Customers = await Api.GetCustomersAsync(1, 100) is { } customers ? customers.Items.ToList() : [];
        Products = await Api.GetProductsAsync(1, 100) is { } products ? products.Items.ToList() : [];
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        OrderList = await Api.GetOrdersAsync(1, 50, FilterStatus) is { } page ? page.Items.ToList() : [];

        if (Selected is not null)
        {
            Selected = await Api.GetOrderAsync(Selected.Id) ?? Selected;
            PaymentList = (await Api.GetPaymentsByOrderAsync(Selected.Id))?.ToList() ?? [];
            Amount = Pending;
        }
    }

    private async Task Select(OrderDto order)
    {
        Selected = await Api.GetOrderAsync(order.Id) ?? order;
        PaymentList = (await Api.GetPaymentsByOrderAsync(order.Id))?.ToList() ?? [];
        Amount = Math.Max(0, Selected.Total - Selected.PaidAmount);
        Message = null;
        Error = false;
    }

    private async Task CreateAsync()
    {
        Message = null;
        Error = false;

        if (CustomerId == Guid.Empty)
        {
            Message = "Elige el cliente.";
            Error = true;
            return;
        }

        if (Lines.Any(l => l.ProductId == Guid.Empty))
        {
            Message = "Cada línea necesita un producto. Quita las líneas vacías o elige producto.";
            Error = true;
            return;
        }

        if (Lines.Any(l => l.Quantity < 1))
        {
            Message = "La cantidad de cada línea debe ser al menos 1.";
            Error = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(ShippingAddress))
        {
            Message = "La dirección de envío es obligatoria.";
            Error = true;
            return;
        }

        Busy = true;

        try
        {
            var order = await Api.CreateOrderAsync(new CreateOrderRequest
            {
                CustomerId = CustomerId,
                ShippingAddress = ShippingAddress.Trim(),
                Items = Lines.Select(l => new OrderItemRequest { ProductId = l.ProductId, Quantity = l.Quantity }).ToList(),
            });

            Message = order is null
                ? "No se pudo crear el pedido. Revisa el stock de los productos."
                : $"Pedido {order.OrderNumber} creado por {order.Total:C} (IVA incluido).";
            Error = order is null;

            if (order is not null)
            {
                Lines = [new LineDraft()];
                await LoadOrdersAsync();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ChargeAsync()
    {
        if (Selected is null) { return; }

        Busy = true;

        try
        {
            // H-09: cash must cover the amount; the change is computed here and recorded by the server.
            if (MethodId == 5 && (CashReceived is null || CashShort))
            {
                Message = CashReceived is null
                    ? "Indica el monto recibido en efectivo."
                    : "El monto recibido es menor que el importe a cobrar.";
                Error = true;
                return;
            }

            var payment = await Api.CreatePaymentAsync(new ManualPaymentRequest
            {
                OrderId = Selected.Id,
                Amount = Amount,
                Method = (ManualPaymentMethod)MethodId,
                Reference = string.IsNullOrWhiteSpace(Reference) ? null : Reference.Trim(),
                CashReceived = MethodId == 5 ? CashReceived : null,
            });

            Message = payment is null
                ? "No se pudo registrar el cobro."
                : payment.ChangeGiven is { } change
                    ? $"Cobro en efectivo de {payment.Amount:C} registrado. Vuelto: {change:C}."
                    : $"Cobro de {payment.Amount:C} registrado.";

            if (payment is not null)
            {
                CashReceived = null;
                Reference = string.Empty;
            }
            Error = payment is null;

            await LoadOrdersAsync();
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task CancelAsync()
    {
        if (Selected is null) { return; }

        Busy = true;

        try
        {
            var ok = await Api.CancelOrderAsync(Selected.Id);
            Message = ok ? "Pedido cancelado y stock devuelto." : "No se pudo cancelar el pedido.";
            Error = !ok;

            await LoadOrdersAsync();
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task AdvanceAsync()
    {
        if (Selected is null) { return; }

        var next = NextTransition(Selected.Status);
        if (next is null) { return; }

        Busy = true;

        try
        {
            var ok = await Api.UpdateOrderStatusAsync(Selected.Id, Enum.Parse<OrderStatus>(next));
            Message = ok ? $"Pedido pasado a {StatusLabel(next)}." : "No se pudo cambiar el estado (transición no permitida).";
            Error = !ok;

            await LoadOrdersAsync();
        }
        finally
        {
            Busy = false;
        }
    }

    // The order DTO carries the state as text, so the next allowed step is resolved by name and
    // matches the transitions enforced by sp_order_change_status.
    private static string? NextTransition(string status) => status switch
    {
        "Pending" => "Confirmed",
        "Confirmed" => "Processing",
        "Processing" => "Shipped",
        "Shipped" => "Delivered",
        _ => null,
    };

    private static string? NextTransitionLabel(string status) => status switch
    {
        "Pending" => "Confirmar",
        "Confirmed" => "En proceso",
        "Processing" => "Enviado",
        "Shipped" => "Entregado",
        _ => null,
    };

    private async Task RefundAsync(PaymentDto payment)
    {
        var ok = await Api.RefundPaymentAsync(payment.Id, payment.RefundableAmount);
        Message = ok ? $"Reembolsado {payment.RefundableAmount:C}." : "No se pudo reembolsar.";
        Error = !ok;

        await LoadOrdersAsync();
    }

    private string CustomerName(Guid id)
    {
        var customer = Customers.FirstOrDefault(c => c.Id == id);
        return customer is null ? id.ToString()[..8] : customer.BusinessName ?? $"{customer.LastName}, {customer.FirstName}";
    }

    // The order DTO carries the state as text (it is what the API returns), so the labels map names.
    private static string StatusLabel(string status) => status switch
    {
        "Pending" => "Pendiente",
        "Confirmed" => "Confirmado",
        "Processing" => "En proceso",
        "Shipped" => "Enviado",
        "Delivered" => "Entregado",
        "Cancelled" => "Cancelado",
        "Refunded" => "Reembolsado",
        _ => status,
    };

    private static string PaymentStatusLabel(PaymentStatus status) => status switch
    {
        PaymentStatus.Pending => "Pendiente",
        PaymentStatus.Authorized => "Autorizado",
        PaymentStatus.Captured => "Cobrado",
        PaymentStatus.Failed => "Fallido",
        PaymentStatus.Refunded => "Reembolsado",
        PaymentStatus.PartiallyRefunded => "Parcial",
        _ => status.ToString(),
    };
}
