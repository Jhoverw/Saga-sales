@page "/login"
@attribute [AllowAnonymous]
@inject ApiClient Api
@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<div class="page-head">
    <div>
        <h1>Entrar</h1>
        <div class="page-head__sub">Acceso al panel de la tienda</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<div class="panel" style="max-width:430px;">
    <div class="panel__body">
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" type="email" @bind="Email" @bind:event="oninput" placeholder="admin@demo.local" />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input class="form-control" type="password" @bind="Password" @bind:event="oninput" />
        </div>
        <button class="btn btn-primary w-100" @onclick="SignInAsync" disabled="@Busy">
            @(Busy ? "Entrando..." : "Entrar")
        </button>
        <hr class="divider" />
        <p class="page-head__sub mb-0">
            ¿No tienes cuenta? <a href="/register">Crea una tienda</a>.
        </p>
    </div>
</div>

@code {
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string? Error { get; set; }
    private bool Busy { get; set; }

    private async Task SignInAsync()
    {
        Busy = true;
        Error = null;

        try
        {
            var login = await Api.LoginAsync(new LoginRequest { Email = Email, Password = Password });

            if (login is null)
            {
                Error = "Email o contraseña incorrectos.";
                return;
            }

            // The token is already in storage; the cascading authentication state has to be told,
            // otherwise the next page still sees an anonymous user and bounces back here.
            AuthState.NotifyChanged();

            Navigation.NavigateTo("/");
        }
        finally
        {
            Busy = false;
        }
    }
}
