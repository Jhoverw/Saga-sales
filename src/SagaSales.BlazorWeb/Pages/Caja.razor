@page "/caja"
@attribute [Authorize]
@using SagaSales.Shared.Pricing
@using SagaSales.Shared.Validation
@inject ApiClient Api
@inject IJSRuntime Js

<PageTitle>Caja</PageTitle>

<style>
    .caja { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: .75rem; }
    .caja__search { position: relative; }
    .caja__results { position: absolute; z-index: 20; left: 0; right: 0; top: 100%; background: #111827; border: 1px solid #334155; border-radius: 6px; max-height: 260px; overflow-y: auto; }
    .caja__results button { display: flex; width: 100%; justify-content: space-between; gap: .75rem; background: none; border: 0; color: #e5e7eb; padding: .45rem .7rem; text-align: left; }
    .caja__results button:hover, .caja__results button.is-active { background: #1e3a8a; }
    .caja__results small { color: #94a3b8; }
    .caja__customer { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
    .caja__customer-name { font-weight: 600; }
    .caja__customer-id { color: #94a3b8; font-size: .85rem; }
    .caja__grid { width: 100%; border-collapse: collapse; }
    .caja__grid th { font-size: .78rem; text-transform: uppercase; color: #94a3b8; border-bottom: 1px solid #334155; padding: .4rem .5rem; white-space: nowrap; }
    .caja__grid td { font-size: .92rem; border-bottom: 1px solid #1f2937; padding: .3rem .5rem; vertical-align: middle; }
    .caja__grid tr.is-entry td { background: #0b1220; }
    .caja__qty { width: 90px; text-align: right; }
    .caja__num { text-align: right; white-space: nowrap; }
    .caja__total { background: #000; color: #22c55e; font-family: 'Consolas', monospace; border-radius: 6px; padding: .6rem .9rem; text-align: right; }
    .caja__total-value { font-size: 2.6rem; line-height: 1.1; letter-spacing: .04em; }
    .caja__total-label { font-size: .75rem; color: #86efac; text-transform: uppercase; }
    .caja__change { font-family: 'Consolas', monospace; font-size: 1.35rem; }
    .caja__hint { font-size: .75rem; color: #94a3b8; }
    @@media (max-width: 1100px) { .caja { grid-template-columns: 1fr; } }
</style>

<div class="page-head">
    <div>
        <h1>Caja</h1>
        <div class="page-head__sub">Venta de mostrador · precios con IVA incluido · F4 cobrar · Esc vaciar</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert @(Error ? "alert-danger" : "alert-info")">@Message</div>
}

<div class="caja" @onkeydown="OnKeyDown">
    <div>
        @* ── Cliente ─────────────────────────────────────────────────────── *@
        <div class="panel">
            <div class="panel__head">Cliente</div>
            <div class="panel__body">
                @if (!ShowNewCustomer)
                {
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <div class="caja__customer">
                                @if (Customer is null)
                                {
                                    <span class="caja__hint">Cargando…</span>
                                }
                                else
                                {
                                    <span class="caja__customer-name">@Customer.DisplayName</span>
                                    <span class="caja__customer-id">@IdentificationLabel(Customer)</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-4 caja__search">
                            <input id="caja-customer" class="form-control" autocomplete="off"
                                   @bind="CustomerSearch" @bind:event="oninput" @bind:after="OnCustomerSearchChangedAsync"
                                   @onkeydown="CustomerSearchKeyDown"
                                   placeholder="Buscar: cédula, RUC o nombre (3 o más)" />
                            @if (CustomerResults.Count > 0)
                            {
                                <div class="caja__results">
                                    @foreach (var candidate in CustomerResults)
                                    {
                                        <button type="button" @onclick="() => SelectCustomer(candidate)">
                                            <span>@candidate.DisplayName</span>
                                            <small>@IdentificationLabel(candidate)</small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button class="btn btn-outline-primary w-100" @onclick="OpenNewCustomer">Nuevo</button>
                            @if (Customer is not null && ConsumerCustomer is not null && Customer.Id != ConsumerCustomer.Id)
                            {
                                <button class="btn btn-outline-secondary w-100" title="Volver a consumidor final"
                                        @onclick="UseConsumer">C. final</button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" @bind="NewType">
                                <option value="@IdentificationType.Cedula">Cédula</option>
                                <option value="@IdentificationType.Ruc">RUC</option>
                                <option value="@IdentificationType.Passport">Pasaporte</option>
                                <option value="@IdentificationType.Foreign">Exterior</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Número</label>
                            <input id="caja-new-number" class="form-control" @bind="NewNumber" @bind:event="oninput" autocomplete="off" />
                        </div>
                        @if (NewIsCompany)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Razón social</label>
                                <input class="form-control" @bind="NewBusinessName" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <label class="form-label">Nombre</label>
                                <input class="form-control" @bind="NewFirstName" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Apellido</label>
                                <input class="form-control" @bind="NewLastName" />
                            </div>
                        }
                        <div class="col-md-4">
                            <label class="form-label">Email (opcional)</label>
                            <input class="form-control" type="email" @bind="NewEmail" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Teléfono (opcional)</label>
                            <input class="form-control" @bind="NewPhone" />
                        </div>
                        <div class="col-md-5 d-flex align-items-end gap-2">
                            <button class="btn btn-primary w-100" @onclick="SaveNewCustomerAsync" disabled="@SavingCustomer">
                                @(SavingCustomer ? "Guardando…" : "Guardar y usar")
                            </button>
                            <button class="btn btn-outline-secondary w-100" @onclick="CloseNewCustomer" disabled="@SavingCustomer">Cancelar</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(NewCustomerError))
                        {
                            <div class="col-12 text-danger small">@NewCustomerError</div>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── Detalle ─────────────────────────────────────────────────────── *@
        <div class="panel mt-3">
            <div class="panel__head">Detalle</div>
            <div class="panel__body p-0">
                <table class="caja__grid">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Descripción</th>
                            <th class="caja__num">Cantidad</th>
                            <th class="caja__num">Precio unit. c/IVA</th>
                            <th class="caja__num">Total c/IVA</th>
                            <th class="caja__num">Stock</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Cart)
                        {
                            <tr>
                                <td>@line.Name</td>
                                <td>@line.Description</td>
                                <td class="caja__num">
                                    <input class="form-control form-control-sm caja__qty ms-auto" type="number" lang="en-US" min="1"
                                           value="@line.Quantity" @onchange="e => ChangeQuantity(line, e)" />
                                </td>
                                <td class="caja__num">@UnitWithTax(line).ToString("C")</td>
                                <td class="caja__num"><strong>@GrossLine(line).ToString("C")</strong></td>
                                <td class="caja__num @(line.Quantity > line.Stock ? "text-danger" : "")"
                                    title="@(line.Quantity > line.Stock ? "La cantidad supera el stock" : null)">@line.Stock</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger" title="Quitar fila" @onclick="() => RemoveLine(line)">×</button>
                                </td>
                            </tr>
                        }
                        <tr class="is-entry">
                            <td colspan="2" class="caja__search">
                                <input id="caja-search" class="form-control form-control-sm" autocomplete="off"
                                       @bind="SearchText" @bind:event="oninput" @bind:after="OnSearchChangedAsync" @onkeydown="SearchKeyDown"
                                       placeholder="Agregar producto: escribe 3 letras o más · Enter agrega" />
                                @if (Results.Count > 0)
                                {
                                    <div class="caja__results">
                                        @for (var i = 0; i < Results.Count; i++)
                                        {
                                            var product = Results[i];
                                            var index = i;
                                            <button type="button" class="@(index == ActiveResult ? "is-active" : "")"
                                                    @onclick="() => AddProduct(product)">
                                                <span>@product.Name</span>
                                                <small>@UnitWithTax(product).ToString("C") · stock @product.StockQuantity</small>
                                            </button>
                                        }
                                    </div>
                                }
                            </td>
                            <td colspan="5" class="caja__hint">
                                @(Cart.Count == 0 ? "Busca un producto para empezar." : $"{Cart.Count} línea(s)")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Total y cobro ───────────────────────────────────────────────────── *@
    <div>
        <div class="caja__total">
            <div class="caja__total-label">Total a pagar</div>
            <div class="caja__total-value">@GrossTotal.ToString("C")</div>
            <div class="caja__hint" style="color:#86efac">IVA incluido @TaxPercentLabel</div>
        </div>

        <div class="panel mt-3">
            <div class="panel__head">Cobro</div>
            <div class="panel__body">
                <div class="mb-2">
                    <label class="form-label">Forma de pago</label>
                    <select class="form-select" @bind="MethodId">
                        <option value="5">Efectivo</option>
                        <option value="1">Tarjeta</option>
                        <option value="4">Transferencia</option>
                        <option value="9">Depósito</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Importe</label>
                    <input class="form-control" type="number" lang="en-US" step="0.01" min="0" @bind="Amount" />
                </div>

                @if (MethodId == 5)
                {
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">Entregado</label>
                            <input class="form-control" type="number" lang="en-US" step="0.01" min="0" @bind="Received" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">A devolver</label>
                            <div class="form-control caja__change">@ChangeDue.ToString("C")</div>
                        </div>
                    </div>
                    @if (ReceivedShort)
                    {
                        <div class="text-danger small mb-2">Lo entregado no cubre el importe.</div>
                    }
                }
                else if (MethodId is 1 or 4 or 9)
                {
                    <div class="mb-2">
                        <label class="form-label">@(MethodId == 1 ? "Últimos 4 dígitos (opcional)" : "Referencia (opcional)")</label>
                        <input class="form-control" @bind="Reference" />
                    </div>
                }

                <button class="btn btn-success btn-lg w-100" @onclick="ChargeAsync"
                        disabled="@(Busy || Cart.Count == 0 || TaxRate is null || Customer is null)">
                    @(Busy ? "Cobrando…" : "Cobrar (F4)")
                </button>

                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-outline-secondary w-50" @onclick="Clear" disabled="@Busy">Vaciar (Esc)</button>
                    <button class="btn btn-outline-secondary w-50" disabled title="Pendiente: ventas en espera (siguiente paso)">En espera</button>
                </div>
                <button class="btn btn-outline-secondary w-100 mt-2" disabled title="Pendiente: crédito al cliente (V-06)">
                    Crédito (pendiente de V-06)
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    // Kept so a store whose consumer was created before spec 002 is still found.
    private const string ConsumerEmail = "consumidor.final@caja.local";

    private string SearchText { get; set; } = string.Empty;
    private List<ProductDto> Results { get; set; } = [];
    private int ActiveResult { get; set; } = 0;
    private List<CartLine> Cart { get; set; } = [];
    private TaxRateDto? TaxRate { get; set; }

    // Customer (spec 002): consumer by default, any customer by search, or a quick sign-up.
    private CustomerDto? Customer { get; set; }
    private CustomerDto? ConsumerCustomer { get; set; }
    private string CustomerSearch { get; set; } = string.Empty;
    private List<CustomerDto> CustomerResults { get; set; } = [];

    private bool ShowNewCustomer { get; set; }
    private bool SavingCustomer { get; set; }
    private IdentificationType NewType { get; set; } = IdentificationType.Cedula;
    private string NewNumber { get; set; } = string.Empty;
    private string NewFirstName { get; set; } = string.Empty;
    private string NewLastName { get; set; } = string.Empty;
    private string NewBusinessName { get; set; } = string.Empty;
    private string NewEmail { get; set; } = string.Empty;
    private string NewPhone { get; set; } = string.Empty;
    private string? NewCustomerError { get; set; }

    private int MethodId { get; set; } = 5;
    private decimal Amount { get; set; }
    private decimal? Received { get; set; }
    private string Reference { get; set; } = string.Empty;

    private string? Message { get; set; }
    private bool Error { get; set; }
    private bool Busy { get; set; }

    private sealed class CartLine
    {
        public Guid ProductId { get; init; }

        public string Name { get; init; } = string.Empty;

        public string Description { get; init; } = string.Empty;

        /// <summary>The product price: the PVP, or the price without VAT for a product not yet converted.</summary>
        public decimal UnitPrice { get; init; }

        public bool IsTaxable { get; init; } = true;

        public bool PriceIncludesTax { get; init; }

        public int Stock { get; init; }

        public int Quantity { get; set; } = 1;
    }

    private decimal Rate => TaxRate?.RatePercentage ?? 0m;

    private string TaxPercentLabel => TaxRate is null ? "(sin IVA vigente)" : $"({Rate * 100:0.##} %)";

    // Same rule as sp_order_create (spec 003): the price is the PVP, so the line total is price × quantity.
    private decimal UnitWithTax(ProductDto product)
        => LinePricing.UnitPriceWithTax(product.BasePrice, product.IsTaxable, product.PriceIncludesTax, Rate);

    private decimal UnitWithTax(CartLine line)
        => LinePricing.UnitPriceWithTax(line.UnitPrice, line.IsTaxable, line.PriceIncludesTax, Rate);

    private decimal GrossLine(CartLine line)
        => LinePricing.Compute(line.UnitPrice, line.Quantity, line.IsTaxable, line.PriceIncludesTax, Rate).Total;

    private decimal GrossTotal => Cart.Sum(GrossLine);

    private decimal ChangeDue => MethodId == 5 && Received is { } r ? Math.Max(0, r - GrossTotal) : 0m;

    private bool ReceivedShort => MethodId == 5 && Received is { } r && r < GrossTotal;

    // A RUC whose third digit is 6 or 9 belongs to a company: it is named by business name (FR-008).
    private bool NewIsCompany
    {
        get
        {
            var number = NewNumber.Trim();
            return NewType == IdentificationType.Ruc && number.Length >= 3 && number[2] is '6' or '9';
        }
    }

    private static string IdentificationLabel(CustomerDto customer)
    {
        var type = customer.IdentificationType switch
        {
            IdentificationType.Cedula => "Cédula",
            IdentificationType.Ruc => "RUC",
            IdentificationType.Passport => "Pasaporte",
            IdentificationType.FinalConsumer => "Consumidor final",
            IdentificationType.Foreign => "Exterior",
            _ => null,
        };

        return type is null ? "sin identificación" : $"{type} · {customer.IdentificationNumber}";
    }

    protected override async Task OnInitializedAsync()
    {
        // A failing API call must not blank the page: the cashier sees why instead.
        try
        {
            TaxRate = await Api.GetCurrentTaxAsync(DateTime.UtcNow);
            if (TaxRate is null)
            {
                Message = "No hay IVA vigente para hoy. Configúralo en Configuración Fiscal antes de vender.";
                Error = true;
            }

            ConsumerCustomer = await FindOrCreateConsumerAsync();
            Customer = ConsumerCustomer;
            if (Customer is null)
            {
                Message = "No se pudo preparar el cliente 'consumidor final'. Revisa la conexión con el servidor.";
                Error = true;
            }
        }
        catch (Exception ex)
        {
            Message = $"Caja no pudo cargar sus datos: {ex.Message}. Recarga la página o revisa la sesión.";
            Error = true;
        }
    }

    private async Task<CustomerDto?> FindOrCreateConsumerAsync()
    {
        var page = await Api.GetCustomersAsync(1, 20, EcuadorIdentification.FinalConsumerNumber);
        var existing = page?.Items.FirstOrDefault(c =>
            c.IdentificationType == IdentificationType.FinalConsumer
            && c.IdentificationNumber == EcuadorIdentification.FinalConsumerNumber);

        if (existing is not null)
        {
            return existing;
        }

        // Before spec 002 the consumer was only recognisable by its email.
        page = await Api.GetCustomersAsync(1, 20, ConsumerEmail);
        existing = page?.Items.FirstOrDefault(c => string.Equals(c.Email, ConsumerEmail, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            return existing;
        }

        return await Api.CreateCustomerAsync(new CreateCustomerRequest
        {
            FirstName = "Consumidor",
            LastName = "Final",
            Email = ConsumerEmail,
            IdentificationType = IdentificationType.FinalConsumer,
            IdentificationNumber = EcuadorIdentification.FinalConsumerNumber,
        });
    }

    // ── customer search ────────────────────────────────────────────────────
    private async Task OnCustomerSearchChangedAsync()
    {
        if (CustomerSearch.Trim().Length < 3)
        {
            CustomerResults = [];
            return;
        }

        try
        {
            var page = await Api.GetCustomersAsync(1, 8, CustomerSearch.Trim());
            CustomerResults = page?.Items.Where(c => c.Status == CustomerStatus.Active).ToList() ?? [];
        }
        catch (Exception ex)
        {
            CustomerResults = [];
            Message = $"No se pudo buscar el cliente: {ex.Message}";
            Error = true;
        }
    }

    private void CustomerSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CustomerResults.Count > 0)
        {
            SelectCustomer(CustomerResults[0]);
        }
    }

    private void SelectCustomer(CustomerDto customer)
    {
        Customer = customer;
        CustomerSearch = string.Empty;
        CustomerResults = [];
        Message = null;
        _ = Js.InvokeVoidAsync("sagaFocus", "caja-search");
    }

    private void UseConsumer()
    {
        if (ConsumerCustomer is not null)
        {
            SelectCustomer(ConsumerCustomer);
        }
    }

    // ── quick sign-up ──────────────────────────────────────────────────────
    private void OpenNewCustomer()
    {
        // A cashier who searched by number usually wants to register that same number.
        var typed = CustomerSearch.Trim();
        NewType = typed.Length == 13 && typed.All(char.IsAsciiDigit) ? IdentificationType.Ruc : IdentificationType.Cedula;
        NewNumber = typed.All(char.IsAsciiLetterOrDigit) ? typed : string.Empty;
        NewFirstName = NewLastName = NewBusinessName = NewEmail = NewPhone = string.Empty;
        NewCustomerError = null;
        CustomerResults = [];
        ShowNewCustomer = true;
        _ = Js.InvokeVoidAsync("sagaFocus", "caja-new-number");
    }

    private void CloseNewCustomer()
    {
        ShowNewCustomer = false;
        NewCustomerError = null;
    }

    private async Task SaveNewCustomerAsync()
    {
        // Same library as the server (FR-009): the cashier sees the problem before the round trip.
        var error = EcuadorIdentification.Validate(NewType, NewNumber);
        if (error is null && NewIsCompany && string.IsNullOrWhiteSpace(NewBusinessName))
        {
            error = "Un RUC de sociedad requiere razón social.";
        }
        else if (error is null && !NewIsCompany
                 && (string.IsNullOrWhiteSpace(NewFirstName) || string.IsNullOrWhiteSpace(NewLastName)))
        {
            error = "Nombre y apellido son obligatorios.";
        }

        if (error is not null)
        {
            NewCustomerError = error;
            return;
        }

        SavingCustomer = true;
        try
        {
            var (created, status, failure) = await Api.CreateCustomerWithResultAsync(new CreateCustomerRequest
            {
                FirstName = NewIsCompany ? string.Empty : NewFirstName.Trim(),
                LastName = NewIsCompany ? string.Empty : NewLastName.Trim(),
                BusinessName = NewIsCompany ? NewBusinessName.Trim() : null,
                Email = string.IsNullOrWhiteSpace(NewEmail) ? null : NewEmail.Trim(),
                Phone = string.IsNullOrWhiteSpace(NewPhone) ? null : NewPhone.Trim(),
                IdentificationType = NewType,
                IdentificationNumber = NewNumber.Trim(),
            });

            if (created is not null)
            {
                ShowNewCustomer = false;
                SelectCustomer(created);
                Message = $"Cliente {created.DisplayName} registrado.";
                Error = false;
                return;
            }

            if (status == System.Net.HttpStatusCode.Conflict)
            {
                // Already registered: show it in the search so the cashier picks it.
                NewCustomerError = "Ya existe un cliente con esa identificación o email en la tienda. Búscalo arriba.";
                ShowNewCustomer = false;
                CustomerSearch = NewNumber.Trim();
                await OnCustomerSearchChangedAsync();
                Message = NewCustomerError;
                Error = true;
                return;
            }

            NewCustomerError = $"No se pudo registrar el cliente: {failure}";
        }
        catch (Exception ex)
        {
            NewCustomerError = $"No se pudo registrar el cliente: {ex.Message}";
        }
        finally
        {
            SavingCustomer = false;
        }
    }

    // ── products ───────────────────────────────────────────────────────────
    private async Task OnSearchChangedAsync()
    {
        if (SearchText.Trim().Length < 3)
        {
            Results = [];
            return;
        }

        // Search is by name until the barcode lookup (V-01) is built.
        try
        {
            var page = await Api.GetProductsAsync(1, 8, SearchText.Trim());
            Results = page?.Items.ToList() ?? [];
            ActiveResult = 0;
        }
        catch (Exception ex)
        {
            Results = [];
            Message = $"No se pudo buscar el producto: {ex.Message}";
            Error = true;
        }
    }

    private void SearchKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                if (Results.Count > 0)
                {
                    AddProduct(Results[Math.Clamp(ActiveResult, 0, Results.Count - 1)]);
                }

                break;
            case "ArrowDown":
                ActiveResult = Math.Min(ActiveResult + 1, Math.Max(0, Results.Count - 1));
                break;
            case "ArrowUp":
                ActiveResult = Math.Max(ActiveResult - 1, 0);
                break;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "F4" && !Busy)
        {
            await ChargeAsync();
        }
        else if (e.Key == "Escape" && !Busy)
        {
            // Esc closes the sign-up form first, so a cashier never loses the sale by accident.
            if (ShowNewCustomer)
            {
                CloseNewCustomer();
            }
            else
            {
                await Clear();
            }
        }
    }

    private void AddProduct(ProductDto product)
    {
        var existing = Cart.FirstOrDefault(l => l.ProductId == product.Id);
        if (existing is not null)
        {
            existing.Quantity++;
        }
        else
        {
            Cart.Add(new CartLine
            {
                ProductId = product.Id,
                Name = product.Name,
                Description = product.Description ?? string.Empty,
                UnitPrice = product.BasePrice,
                IsTaxable = product.IsTaxable,
                PriceIncludesTax = product.PriceIncludesTax,
                Stock = product.StockQuantity,
            });
        }

        SearchText = string.Empty;
        Results = [];
        Amount = GrossTotal;
        Message = null;
        _ = Js.InvokeVoidAsync("sagaFocus", "caja-search");
    }

    private void ChangeQuantity(CartLine line, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var quantity) && quantity >= 1)
        {
            line.Quantity = quantity;
        }

        Amount = GrossTotal;
    }

    private void RemoveLine(CartLine line)
    {
        Cart.Remove(line);
        Amount = GrossTotal;
    }

    private Task Clear()
    {
        Cart.Clear();
        Received = null;
        Reference = string.Empty;
        Amount = 0;
        Message = null;
        Results = [];
        SearchText = string.Empty;
        return Js.InvokeVoidAsync("sagaFocus", "caja-search").AsTask();
    }

    private async Task ChargeAsync()
    {
        if (Cart.Count == 0 || Customer is null || TaxRate is null) { return; }

        if (MethodId == 5 && (Received is null || ReceivedShort))
        {
            Message = Received is null ? "Indica lo que entregó el cliente." : "Lo entregado no cubre el importe.";
            Error = true;
            return;
        }

        Busy = true;

        try
        {
            var buyer = Customer;
            var order = await Api.CreateOrderAsync(new CreateOrderRequest
            {
                CustomerId = buyer.Id,
                ShippingAddress = "Mostrador",
                Items = Cart.Select(l => new OrderItemRequest { ProductId = l.ProductId, Quantity = l.Quantity }).ToList(),
            });

            if (order is null)
            {
                Message = "No se pudo crear la venta. Revisa el stock de los productos.";
                Error = true;
                return;
            }

            var toPay = Amount > 0 ? Amount : order.Total;
            var payment = await Api.CreatePaymentAsync(new ManualPaymentRequest
            {
                OrderId = order.Id,
                Amount = toPay,
                Method = (ManualPaymentMethod)MethodId,
                Reference = string.IsNullOrWhiteSpace(Reference) ? null : Reference.Trim(),
                CashReceived = MethodId == 5 ? Received : null,
            });

            if (payment is null)
            {
                Message = $"La venta {order.OrderNumber} quedó creada, pero el cobro no se registró. Cóbrala desde Pedidos.";
                Error = true;
                return;
            }

            var change = payment.ChangeGiven is { } c && c > 0 ? $" Vuelto: {c:C}." : string.Empty;
            var pending = order.Total - toPay;
            var balance = pending > 0 ? $" Pendiente: {pending:C}." : string.Empty;
            Message = $"Venta {order.OrderNumber} a {buyer.DisplayName} cobrada por {toPay:C}.{change}{balance}";
            Error = false;

            Cart.Clear();
            Received = null;
            Reference = string.Empty;
            Amount = 0;

            // The next sale starts again with consumidor final (spec 002, US1).
            Customer = ConsumerCustomer ?? Customer;
            await Js.InvokeVoidAsync("sagaFocus", "caja-search");
        }
        catch (Exception ex)
        {
            Message = $"No se pudo completar la venta: {ex.Message}. Revisa Pedidos antes de reintentar.";
            Error = true;
        }
        finally
        {
            Busy = false;
        }
    }
}
