@inject NavigationManager Navigation

<aside class="sidebar">
    <div class="sidebar__brand">
        <i class="fa-solid fa-house fa-2x icon-brand"></i>
        <span>Saga-Sales</span>
    </div>

    <div class="sidebar__section">Principal</div>
    <nav class="sidebar__nav">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <i class="fa-solid fa-house fa-fw icon-red"></i>
            <span class="nav-text">Panel</span>
        </NavLink>

        <NavLink class="nav-item nav-highlight" href="caja">
            <i class="fa-solid fa-cash-register fa-fw icon-green"></i>
            <span class="nav-text">Caja</span>
        </NavLink>

        <NavLink class="nav-item nav-highlight" href="orders">
            <i class="fa-solid fa-shopping-basket fa-fw icon-orange"></i>
            <span class="nav-text">Pedidos</span>
        </NavLink>

        <NavLink class="nav-item nav-highlight" href="analytics">
            <i class="fa-solid fa-chart-line fa-fw icon-purple"></i>
            <span class="nav-text">Analítica</span>
        </NavLink>

        <div class="sidebar__section">Catálogo e Inventario</div>
        <NavLink class="nav-item" href="products">
            <i class="fa-solid fa-box fa-fw icon-blue"></i>
            <span class="nav-text">Productos</span>
        </NavLink>

        <NavLink class="nav-item" href="stock">
            <i class="fa-solid fa-database fa-fw icon-teal"></i>
            <span class="nav-text">Existencias</span>
        </NavLink>

        <NavLink class="nav-item" href="branches">
            <i class="fa-solid fa-building fa-fw icon-green"></i>
            <span class="nav-text">Sucursales</span>
        </NavLink>

        <div class="sidebar__section">Abastecimiento</div>
        <NavLink class="nav-item" href="suppliers">
            <i class="fa-solid fa-user-tag fa-fw icon-yellow"></i>
            <span class="nav-text">Proveedores</span>
        </NavLink>

        <NavLink class="nav-item" href="purchases">
            <i class="fa-solid fa-receipt fa-fw icon-orange-dark"></i>
            <span class="nav-text">Compras</span>
        </NavLink>

        <div class="sidebar__section">Administración</div>
        <NavLink class="nav-item" href="customers">
            <i class="fa-solid fa-users fa-fw icon-pink"></i>
            <span class="nav-text">Clientes</span>
        </NavLink>

        <NavLink class="nav-item" href="settings">
            <i class="fa-solid fa-cog fa-fw icon-gray"></i>
            <span class="nav-text">Parámetros</span>
        </NavLink>

        <NavLink class="nav-item" href="taxes">
            <i class="fa-solid fa-percent fa-fw icon-blue"></i>
            <span class="nav-text">Configuración Fiscal</span>
        </NavLink>

        <NavLink class="nav-item" href="ecuador-invoicing">
            <i class="fa-solid fa-file-invoice fa-fw icon-green-dark"></i>
            <span class="nav-text">Facturación EC</span>
        </NavLink>
    </nav>

    <div class="sidebar__foot">
        <button class="btn btn-outline-secondary btn-sm w-100" @onclick="SignOut">Cerrar sesión</button>
    </div>
    <div class="sidebar__footer" style="margin-top: auto; padding: 1rem; font-size: 0.75rem; color: #666; text-align: center; border-top: 1px solid #eee;">
        <span>Build: <strong>@_buildLabel</strong></span>
    </div>
</aside>

@code {
    [Inject]
    private TokenStore Store { get; set; } = default!;

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    // Same label as the footer. index.html fetches assets/build-id.txt once and exposes it through
    // window.sagaReadBuildLabel, so the sidebar reads it after Blazor renders it.
    private string _buildLabel = "…";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _buildLabel != "…") return;
        try
        {
            _buildLabel = await Js.InvokeAsync<string>("sagaReadBuildLabel");
            StateHasChanged();
        }
        catch (JSException)
        {
            _buildLabel = "no disponible";
            StateHasChanged();
        }
    }

    private async Task SignOut()
    {
        await Store.ClearAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
